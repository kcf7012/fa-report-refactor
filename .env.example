# ============================================
# FA Improver - 環境變數範例
# ============================================
# 複製此檔為 .env 並填入實際值:
#   cp .env.example .env
# .env 不會被 git 追蹤(已加入 .gitignore)
# ============================================

# OpenAI API Key(必填,用於 --llm-provider openai)
# 申請位置:https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# LLM 模型(選填,預設 gpt-4o-mini)
# 可選值:gpt-4o-mini / gpt-4o / gpt-4o-2024-08-06 / o1-mini ...
FA_IMPROVER_MODEL=gpt-4o-mini

# LLM Provider(選填,預設 openai)
# 可選值:openai / mock(測試用,無需 API key)
FA_IMPROVER_LLM_PROVIDER=openai

# OpenAI 相容 API 的自訂 endpoint(選填)
# 不填寫 = 使用官方 OpenAI endpoint
# 範例(以下為各家相容 API):
#   Groq:     https://api.groq.com/openai/v1
#   Together: https://api.together.xyz/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Azure:    https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
# OPENAI_BASE_URL=

# HTTP 請求超時(選填,秒,預設 60)
# FA_IMPROVER_LLM_TIMEOUT=60

# 最大重試次數(選填,預設 3)
# FA_IMPROVER_LLM_MAX_RETRIES=3

# 開發模式:啟用 mock client(用於測試,無需真實 API)
# FA_IMPROVER_DEV_MODE=true